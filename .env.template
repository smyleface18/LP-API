# CORS: orígenes permitidos separados por coma (vacío = todos, solo para desarrollo)
CORS_ORIGINS=

# Amazon Bedrock: revisión de inglés del modo Historieta (Nova 2 Lite, Converse API).
# BEDROCK_REVIEW_MODEL_ID: inference profile de Nova 2 Lite (ej. us.amazon.nova-2-lite-v1:0).
# Nova 2 Lite no admite on-demand con el model ID base (amazon.nova-2-lite-v1:0): Bedrock
# responde "on-demand throughput isn't supported". Sin definir, el juego sigue sin revisión.
# BEDROCK_REGION: vacío = AWS_REGION.
BEDROCK_REGION=
BEDROCK_REVIEW_MODEL_ID=

# Media del modo Historieta: audio con Polly.
# POLLY_VOICE_ID: voz neural en inglés (vacío = Joanna). POLLY_REGION: vacío = AWS_REGION.
POLLY_VOICE_ID=
POLLY_REGION=

# Imágenes de las viñetas. IMAGE_PROVIDER: none (vacío = none, sin imágenes) | cloudflare.
# Con cloudflare, CF_ACCOUNT_ID y CF_API_TOKEN son obligatorias (sin ellas la app no arranca).
# CF_API_TOKEN: token con permiso solo de Workers AI (ver src/modules/story-media/README.md).
# CF_IMAGE_MODEL: vacío = @cf/black-forest-labs/flux-1-schnell.
# IMAGE_TIMEOUT_MS: tiempo máximo de cada intento de dibujar una viñeta (vacío = 20000).
IMAGE_PROVIDER=
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=
IMAGE_TIMEOUT_MS=
